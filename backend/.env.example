APP_NAME="MERITLIVES LLC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meritlives
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- MERITLIVES application-specific ---
FRONTEND_URL=http://localhost:3000
NEWS_API_KEY=
YOUTUBE_API_KEY=
WATCH_RECENT_DAYS=30
WATCH_MAX_VIDEOS_PER_SOURCE=30
WATCH_API_TIMEOUT_SECONDS=20

# OpenAI Editorial AI Studio. Never commit real API keys.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_COMPRESSION=82
OPENAI_IMAGE_ESTIMATED_COST_USD=0.10
OPENAI_IMAGE_MONTHLY_BUDGET_USD=5.00
OPENAI_IMAGE_DAILY_LIMIT=10
OPENAI_IMAGE_TIMEOUT=180

OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_ARTICLE_MAX_OUTPUT_TOKENS=1800
OPENAI_ARTICLE_ESTIMATED_COST_USD=0.05
OPENAI_ARTICLE_MONTHLY_BUDGET_USD=3.00
OPENAI_ARTICLE_DAILY_LIMIT=10
OPENAI_ARTICLE_MINIMUM_SOURCE_WORDS=180
OPENAI_ARTICLE_TIMEOUT=120
EDITORIAL_MINIMUM_WORD_COUNT=300

# WordPress news import. Imported stories are placed in pending review.
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
WP_SITE_URL=https://meritlives.com
# Comma-separated exact HTTPS hosts permitted for media downloads; defaults to WP_SITE_URL host.
WP_IMAGE_ALLOWED_HOSTS=
WP_IMPORT_SOURCE_NAME=MERITLIVES

ADMIN_SEED_EMAIL=admin@meritlives.local
ADMIN_SEED_PASSWORD=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
