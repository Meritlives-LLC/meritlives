APP_NAME="MERITLIVES LLC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meritlives
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- MERITLIVES application-specific ---
FRONTEND_URL=http://localhost:3000
NEWS_API_KEY=
YOUTUBE_API_KEY=
WATCH_RECENT_DAYS=30
WATCH_MAX_VIDEOS_PER_SOURCE=30
WATCH_API_TIMEOUT_SECONDS=20

# WordPress news import (php artisan news:import-wordpress). Leave blank if
# you're not importing. WP_DB_HOST/PORT can point at a different server than
# DB_HOST above if WordPress is hosted elsewhere.
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
WP_SITE_URL=https://meritlives.com
WP_IMAGE_ALLOWED_HOSTS=
WP_IMPORT_SOURCE_NAME=MERITLIVES

# AI Studio remains disabled unless explicitly enabled and configured.
AI_STUDIO_ENABLED=false
AI_STUDIO_PROVIDER=none
AI_STUDIO_MODEL=
OPENAI_API_KEY=
AI_STUDIO_CONNECT_TIMEOUT_SECONDS=5
AI_STUDIO_TIMEOUT_SECONDS=45
AI_STUDIO_MAX_OUTPUT_TOKENS=1200

# Filament admin seeder (php artisan db:seed). If ADMIN_SEED_PASSWORD is left
# blank, a random password is generated and printed once during seeding —
# capture it immediately. Always rotate this password before go-live.
ADMIN_SEED_EMAIL=admin@meritlives.local
ADMIN_SEED_PASSWORD=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
AI_EDITORIAL_ENABLED=false
AI_EDITORIAL_PROVIDER=mock
# Set a Responses API model before using the openai editorial provider.
OPENAI_MODEL=

# Feature images are independent of the AI writing provider. Mock mode makes no external requests.
AI_IMAGE_ENABLED=false
AI_IMAGE_PROVIDER=mock
AI_IMAGE_ALLOW_BILLABLE=false
# Select a documented supported model only after explicit live-generation approval.
AI_IMAGE_MODEL=
AI_IMAGE_QUALITY=medium
AI_IMAGE_PER_MINUTE=3
AI_IMAGE_PER_DAY=20
